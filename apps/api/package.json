{
  "name": "@squinder/api",
  "version": "0.1.0",
  "description": "Squinder realtime API",
  "main": "dist/app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "pnpm build && c8 tsx --test \"test/**/*.test.ts\"",
    "start": "fastify start -l info -a 0.0.0.0 dist/app.js",
    "build": "tsc",
    "build:ts": "pnpm build",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "watch:ts": "tsc -w",
    "dev": "pnpm build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"pnpm:watch:ts\" \"pnpm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/websocket": "^11.3.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^6.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "c8": "^12.0.0",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "fastify-tsconfig": "^3.0.0",
    "tsx": "^4.23.11",
    "typescript": "~7.0.2"
  }
}